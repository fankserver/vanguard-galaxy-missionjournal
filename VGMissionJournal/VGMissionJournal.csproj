<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>VGMissionJournal</AssemblyName>
    <Product>Mission Journal</Product>
    <Version>0.5.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>VGMissionJournal</RootNamespace>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
    </RestoreAdditionalProjectSources>
    <!-- BepInEx / HarmonyX / UnityEngine.Modules are compile-only (the game /
         BepInEx ship them at runtime) so they stay out of bin. Newtonsoft.Json
         WAS compile-only too, but game 0.8.1 removed Newtonsoft.Json.dll from
         Managed/ — so we now ship it (IncludeAssets includes runtime →
         CopyLocalLockFileAssemblies drops it in bin → deploy copies it beside
         the plugin). Log-shape is all primitive / nullable-primitive records —
         no TypeNameHandling.Auto surface, so we need no System.Text.Json
         fallback and no ISerializationBinder. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.*" IncludeAssets="compile" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" IncludeAssets="compile" />
    <PackageReference Include="UnityEngine.Modules" Version="6000.2.6" IncludeAssets="compile" />
    <!-- Ships at runtime: game 0.8.1 no longer provides Newtonsoft.Json.dll. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" IncludeAssets="compile;runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pure observer: no Harmony patches and no compile-time game reference.
         Native detail inspection goes through the API's version-sensitive
         escape hatch + VanillaReflection (see MissionRecordBuilder). -->
    <Reference Include="VGModAPI.Abstractions">
      <HintPath>lib/VGModAPI.Abstractions.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VGMissionJournal.Tests" />
  </ItemGroup>

</Project>
