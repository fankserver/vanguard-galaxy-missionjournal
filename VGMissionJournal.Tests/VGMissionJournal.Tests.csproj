<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>VGMissionJournal.Tests</RootNamespace>
    <!-- Referencing VGMissionJournal.csproj transitively pulls BepInEx.Core etc. from
         nuget.bepinex.dev; the Microsoft.NET.Test.Sdk + xunit packages live on
         nuget.org. Include both so restore works from either direction. -->
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
    </RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.*" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.*" />
    <!-- The plugin assembly no longer references game or Harmony assemblies; the
         publicized stub stays OUT of the test project too — builder tests use
         shape-matched POCO fakes. UnityEngine reference assemblies remain for
         CLR resolution when the Plugin type (BaseUnityPlugin : MonoBehaviour)
         is loaded, e.g. by the assembly-reference assertion tests. -->
    <PackageReference Include="UnityEngine.Modules" Version="6000.2.6" />
    <!-- VGMissionJournal marks BepInEx.Core IncludeAssets="compile" so the
         runtime assemblies don't ship in the deployed plugin — the game
         provides them. xUnit DOES need them at runtime when exercising config
         bindings and logging, so pull them in directly here to bypass the
         transitive-assets filter. BepInEx.Core is a meta-package; BepInEx.dll
         itself ships in BaseLib. -->
    <PackageReference Include="BepInEx.BaseLib" Version="5.*" />
    <!-- Newtonsoft.Json is also compile-only in VGMissionJournal (game provides
         it), but xUnit needs it at runtime to exercise the persistence
         roundtrip tests in Phase 3. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VGMissionJournal\VGMissionJournal.csproj" />
    <Reference Include="VGModAPI.Abstractions">
      <HintPath>..\VGMissionJournal\lib\VGModAPI.Abstractions.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="Fixtures/**/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
